# Image backend PoolRouter (ADR-0001 Addendum A §3.1, §3.3, §6, §7).
# Satu image memuat binary webserver, controller, worker, backend-cli, dan migrate (migrasi skema, ARC-254).
# Compose memilih proses lewat `command:`;
# backend-cli dijalankan lewat service backend-cli (profile cli, `compose run --rm`) atau `exec` di container backend
# (ADR-0003 §3.6c, docs/runbook/deploy.md).
# Build (dari akar repo): podman build -f backend/Containerfile backend   (atau docker build, konteks backend/)
# Tanpa fitur khusus BuildKit: tanpa `# syntax=`, tanpa HEALTHCHECK/SHELL/ONBUILD, tanpa COPY --link/--parents/--exclude.
# Pengecualian: `RUN --mount=type=cache` di stage build, diizinkan Addendum A §3.3 (didukung Buildah dan Docker 27).
# Healthcheck ditulis di Compose: `webserver healthcheck` (subcommand menunggu SHAA-175).

# Image dasar di-pin dengan tag dan digest, ditulis literal di baris FROM (lint compose-lint membaca FROM literal). Build stage sama dengan backend/Makefile dan backend.yml (ADR-0004 §2).
# Jumlah job cargo. Default 2 untuk runner CI. VM Podman 3,7 GiB memakai JOBS=1 (SHAA-222), diteruskan lewat `make image JOBS=1`.
ARG JOBS=2
# Metadata OCI, diisi lewat --build-arg oleh pemanggil (commit hash, waktu build, versi).
ARG VERSION=0.1.0
ARG REVISION=unknown
ARG CREATED=unknown

# Build stage: rust 1.99.1 bookworm (digest sama dengan backend.yml).
FROM docker.io/library/rust:1.99.1-bookworm@sha256:9181b56c2a21ab1d5e73cffe04fc762426d30aa7fac3c91141dd033f49a7fc8b AS build
ARG JOBS
ENV CARGO_BUILD_JOBS=${JOBS} \
    SQLX_OFFLINE=true \
    CARGO_TERM_COLOR=never
WORKDIR /src
COPY . .
# Cache registry dan target hanya ada selama build; binary disalin ke /out dalam RUN yang sama.
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/src/target,sharing=locked \
    cargo build --release --locked --bin webserver --bin controller --bin worker --bin backend-cli --bin migrate \
 && mkdir -p /out \
 && cp target/release/webserver target/release/controller target/release/worker target/release/backend-cli target/release/migrate /out/

# Runtime glibc (bookworm, sama dengan build stage). Digest index multi-arch, diambil 2026-11-03.
FROM docker.io/library/debian:bookworm-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3
ARG VERSION
ARG REVISION
ARG CREATED
LABEL org.opencontainers.image.source="https://github.com/faisalcayunda/PoolRouter" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.created="${CREATED}" \
      org.opencontainers.image.title="poolrouter-backend" \
      org.opencontainers.image.licenses="UNLICENSED"
# bookworm-slim 12.15 masih membawa apt/libapt-pkg6.0 2.6.1 yang terkena CVE-2026-109518;
# belum ada digest bookworm-slim yang memuat 2.6.2, jadi upgrade di sini lalu bersihkan daftar apt.
# ca-certificates (ARC-254): bookworm-slim tidak memuatnya, dan reqwest 0.13 panik saat Client::new() tanpa CA
# sistem, sehingga `webserver healthcheck`, `controller healthcheck`, dan `worker liveness` mati walau /readyz
# menjawab 200. Versi dikunci seperti pgbackrest di deploy/compose/backup/Containerfile; bump lewat
# `apt-cache policy ca-certificates` di image dasar. `--only-upgrade` tidak memasang paket baru, jadi
# ca-certificates ada di perintah install terpisah.
RUN apt-get update \
 && apt-get install -y --no-install-recommends --only-upgrade apt \
 && apt-get install -y --no-install-recommends ca-certificates=20250419~deb12u2 \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/webserver /out/controller /out/worker /out/backend-cli /out/migrate /usr/local/bin/
# User numerik tetap (ADR-0001 Addendum A §6, D5). Tidak bergantung pada entri /etc/passwd.
USER 10001:10001
WORKDIR /
CMD ["webserver"]
