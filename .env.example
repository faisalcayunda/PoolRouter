POOLROUTER_DB_PORT=${POOLROUTER_DB_PORT}
POOLROUTER_DB_NAME=${POOLROUTER_DB_NAME}
POOLROUTER_DB_SSLMODE=${POOLROUTER_DB_SSLMODE}
POOLROUTER_DB_OWNER_PASSWORD_FILE=${POOLROUTER_DB_OWNER_PASSWORD_FILE}
POOLROUTER_DB_API_PASSWORD_FILE=${POOLROUTER_DB_API_PASSWORD_FILE}
POOLROUTER_DB_ADMIN_API_PASSWORD_FILE=${POOLROUTER_DB_ADMIN_API_PASSWORD_FILE}
POOLROUTER_DB_CONTROLLER_PASSWORD_FILE=${POOLROUTER_DB_CONTROLLER_PASSWORD_FILE}
POOLROUTER_DB_WEBHOOK_PASSWORD_FILE=${POOLROUTER_DB_WEBHOOK_PASSWORD_FILE}
POOLROUTER_DB_WORKER_PASSWORD_FILE=${POOLROUTER_DB_WORKER_PASSWORD_FILE}
POOLROUTER_REDIS_HOST=${POOLROUTER_REDIS_HOST}
POOLROUTER_REDIS_PORT=${POOLROUTER_REDIS_PORT}
POOLROUTER_REDIS_PASSWORD_FILE=${POOLROUTER_REDIS_PASSWORD_FILE}
POOLROUTER_RABBITMQ_HOST=${POOLROUTER_RABBITMQ_HOST}
POOLROUTER_RABBITMQ_PORT=${POOLROUTER_RABBITMQ_PORT}
POOLROUTER_RABBITMQ_VHOST=${POOLROUTER_RABBITMQ_VHOST}
POOLROUTER_RABBITMQ_USER=${POOLROUTER_RABBITMQ_USER}
POOLROUTER_RABBITMQ_PASSWORD_FILE=${POOLROUTER_RABBITMQ_PASSWORD_FILE}
POOLROUTER_KEK_FILE=${POOLROUTER_KEK_FILE}
