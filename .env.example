# Placeholders only (Kontrak env backend PoolRouter v1, section 2).
# Real values come from the environment. Secrets are never given by value:
# every *_FILE variable holds a path such as /run/secrets/<name>, and the
# backend refuses to start if a secret variable without _FILE carries a value.
# POOLROUTER_SEED_PASSWORD_FILE is for the admin CLI in dev and ci only.
POOLROUTER_ENV=${POOLROUTER_ENV}
POOLROUTER_TOKEN_ISSUER=${POOLROUTER_TOKEN_ISSUER}
POOLROUTER_UI_ORIGIN=${POOLROUTER_UI_ORIGIN}
