# Template env dev (ADR-0001 Addendum A §4, kontrak env backend v1). Tanpa nilai rahasia.
# Salin ke deploy/compose/env/dev.env (di-gitignore) atau ke path lain di luar repo,
# lalu isi nilai sesungguhnya. Secret TIDAK ditulis di file ini.

# Direktori secret di luar repo (dir 0700, file 0444). Nama file = nama secret (kontrak §2, §3):
# db_password, redis_password, rabbitmq_password, poolrouter_owner, pr_api, pr_admin_api,
# pr_controller, pr_webhook, pr_worker, poolrouter_kek, poolrouter_jwt_signing_key,
# poolrouter_nik_hmac_key, poolrouter_idempotency_hmac_key, poolrouter_seed_password (dev saja),
# objstore_root_user, objstore_root_password (profile objstore).
POOLROUTER_SECRETS_DIR=/path/di/luar/repo/secrets/dev

POOLROUTER_ENV=dev
POOLROUTER_TOKEN_ISSUER=poolrouter-dev
POOLROUTER_UI_ORIGIN=http://127.0.0.1:8080

# Port host (bind ke loopback; port container selalu >= 1024).
POOLROUTER_BIND_ADDR=127.0.0.1
POOLROUTER_HTTP_PORT=8080
POOLROUTER_MOCK_PORT=18080

# Database bawaan (profile bundled-infra). Nama dan user non-rahasia. Role per komponen dibuat di SHAA-193.
POSTGRES_DB=poolrouter
POSTGRES_USER=poolrouter_admin
POOLROUTER_DB_HOST=postgres
POOLROUTER_DB_PORT=5432

# Redis dan RabbitMQ bawaan (profile bundled-infra).
POOLROUTER_REDIS_HOST=redis
POOLROUTER_REDIS_PORT=6379
POOLROUTER_RABBITMQ_HOST=rabbitmq
POOLROUTER_RABBITMQ_PORT=5672
POOLROUTER_RABBITMQ_VHOST=/
RABBITMQ_USER=poolrouter

# Image aplikasi. Dev membangun lokal (`make image`), jadi tanpa digest.
POOLROUTER_BACKEND_IMAGE=localhost/poolrouter-backend:dev
POOLROUTER_FRONTEND_IMAGE=localhost/poolrouter-frontend:dev
POOLROUTER_MOCK_DUKCAPIL_IMAGE=localhost/poolrouter-mock-dukcapil:dev

# Object storage arsip dev (profile objstore, SHAA-334). Bucket dibuat idempoten oleh objstore-init.
POOLROUTER_ARSIP_BUCKET=poolrouter-arsip-dev
POOLROUTER_ARSIP_RETENSI_HARI=1
