# Image frontend PoolRouter (ADR-0003 §3.9): build statis Vite disajikan nginx-unprivileged,
# yang juga mem-proxy /admin/v1/ ke webserver (satu origin).
# Build (dari akar repo): docker build -f frontend/Containerfile frontend   (atau podman build)
# Tanpa fitur khusus BuildKit. Build tidak memuat secret; VITE_* hanya untuk nilai non-rahasia.

# Build stage: Node sama dengan frontend/Makefile (NODE_IMAGE) dan .nvmrc.
FROM docker.io/library/node:24.22.2-bookworm-slim@sha256:c86ecead9e55a5210ac1727de38a4ca840bf03dcaf34dc9749addbf383b1920c AS build
ENV COREPACK_HOME=/tmp/corepack COREPACK_ENABLE_DOWNLOAD_PROMPT=0 CI=1
WORKDIR /src
COPY package.json pnpm-lock.yaml ./
RUN corepack enable && pnpm install --frozen-lockfile --network-concurrency 2
COPY . .
RUN corepack enable && pnpm build

# Runtime: nginx-unprivileged 1.28 (alpine), tag dan digest index multi-arch di-pin.
FROM docker.io/nginxinc/nginx-unprivileged:1.28-alpine@sha256:7377697a821c131a924a7105fafbe7414db4e9fcc77a6f08f776f33f141ec3f8
ARG VERSION=0.1.0
ARG REVISION=unknown
ARG CREATED=unknown
LABEL org.opencontainers.image.source="https://github.com/faisalcayunda/PoolRouter" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.created="${CREATED}" \
      org.opencontainers.image.title="poolrouter-frontend" \
      org.opencontainers.image.licenses="UNLICENSED"
# Template dirender entrypoint ke /tmp/nginx-conf (tmpfs; root filesystem bisa read-only).
# Hanya variabel POOLROUTER_* yang disubstitusi, jadi $host dan sejenisnya aman.
ENV NGINX_ENVSUBST_OUTPUT_DIR=/tmp/nginx-conf \
    NGINX_ENVSUBST_FILTER=^POOLROUTER_ \
    POOLROUTER_ENV=dev \
    POOLROUTER_ADMIN_API_UPSTREAM=backend-webserver:8082 \
    POOLROUTER_ADMIN_IP_ALLOWLIST=
COPY deploy/nginx.conf /etc/nginx/nginx.conf
COPY deploy/security-headers.conf /etc/nginx/poolrouter/security-headers.conf
COPY deploy/default.conf.template /etc/nginx/templates/default.conf.template
COPY --chmod=0755 deploy/15-poolrouter-prepare.sh /docker-entrypoint.d/15-poolrouter-prepare.sh
COPY --from=build /src/dist /usr/share/nginx/html
USER 10001:10001
EXPOSE 8080
