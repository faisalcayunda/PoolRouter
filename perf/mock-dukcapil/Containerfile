# Mock upstream Dukcapil untuk uji beban SHAA-205. Hanya data sintetis.
# Image dipin ke tag dan digest; jangan ganti ke `latest`.
FROM docker.io/library/python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MOCK_PORT=8080

# bookworm-slim masih membawa apt/libapt-pkg6.0 2.6.1 (CVE-2026-109518); upgrade di sini
# lalu bersihkan daftar apt (pola sama dengan backend/Containerfile).
RUN apt-get update \
 && apt-get install -y --no-install-recommends --only-upgrade apt \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY server.py /app/server.py

USER 10001:10001
EXPOSE 8080
CMD ["python", "-I", "/app/server.py"]
